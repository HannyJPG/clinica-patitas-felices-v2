# Configuración del Adaptador de Base de Datos (sqlite | mysql | supabase)
DB_ENGINE=sqlite
SQLITE_PATH=database/patitas_felices.db

# Configuración para Supabase (PostgreSQL)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Configuración para MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=patitas_felices

# Configuración de Seguridad JWT / Proxy y WhatsApp Adapter
JWT_SECRET=patitas-felices-clave-secreta-2026
CLINICA_WHATSAPP=51990853697
