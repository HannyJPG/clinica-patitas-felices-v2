{
  "name": "patitas-felices-astro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/iniciar-todo.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "api": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:py": "python -m pytest backend/tests/test_patterns_and_api.py -v",
    "test:e2e": "playwright test",
    "check:build": "node scripts/verificar-migracion.mjs"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
