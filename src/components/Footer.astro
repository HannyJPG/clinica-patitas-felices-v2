---
import { clinica } from "../data/clinica.js";
import { enlaceWhatsApp } from "../scripts/whatsapp.js";
const anio = new Intl.DateTimeFormat("es-PE", { timeZone: "America/Lima", year: "numeric" }).format(new Date());
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-brand-name">Patitas Felices</a>
        <p>Un cuidado cercano para quienes son parte de tu familia.</p>
        <a class="footer-phone" href={enlaceWhatsApp()} target="_blank" rel="noopener noreferrer">WhatsApp {clinica.telefonoVisible} <span aria-hidden="true">↗</span></a>
      </div>
      <nav aria-label="Navegación del pie de página">
        <a href="/">Inicio</a>
        <a href="/#servicios">Servicios</a>
        <a href="/tienda">Tienda</a>
        <a href="/agendar-cita">Agendar cita</a>
        <a href="/login">Iniciar sesión</a>
        <a href="/doctor">Agenda Doctor</a>
        <a href="/admin">CRM Admin</a>
        <a href="/soon">Novedades</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; {anio} Clínica Patitas Felices.</p>
      <p>Las citas se confirman por WhatsApp.</p>
    </div>
  </div>
</footer>
